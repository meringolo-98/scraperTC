# Optional contact shown in User-Agent for polite academic APIs (OpenAlex, NCBI).
CONTACT_EMAIL=you@example.com

# YouTube Data API v3 — enables live video search.
YOUTUBE_API_KEY=

# Brave Search — the web-wide index (Google CSE replacement).
# https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# Optional. Raises Semantic Scholar rate limits.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Google Programmable Search — only if your account can still enable Custom Search API.
# Closed to new customers; full-web CSE dies 1 Jan 2027. Prefer Brave.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Reddit OAuth (script/app credentials). Public JSON is tried first;
# OAuth is used when Reddit blocks unauthenticated search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=scraperTC/0.1 by yourname

# GitHub raises unauthenticated rate limits if set.
GITHUB_TOKEN=

# SQLite path. Default: data/chatter.db
SCRAPERTC_DB=data/chatter.db
